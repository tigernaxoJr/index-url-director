{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project.schema.json",
  "title": "SlideProject",
  "type": "object",
  "required": ["specVersion", "id", "title", "status", "updatedAt"],
  "properties": {
    "specVersion": { "type": "string", "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "theme": { "type": "string", "default": "default" },
    "aspectRatio": { "type": "string", "default": "16/9" },
    "status": {
      "type": "string",
      "enum": ["initialized", "outlined", "drafted", "visualized", "exported", "failed"]
    },
    "pagesCount": { "type": "integer", "minimum": 1 },
    "export": {
      "type": "object",
      "properties": {
        "pdfPath": { "type": "string" },
        "exportedAt": { "type": "string", "format": "date-time" },
        "sizeBytes": { "type": "integer" }
      }
    },
    "updatedAt": { "type": "string", "format": "date-time" },
    "updatedBy": { "type": "string", "enum": ["user", "agent"] }
  },
  "additionalProperties": false
}
